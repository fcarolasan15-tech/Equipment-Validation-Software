          },
          {
            "name": "Top GHP Category YTD",
            "expression": [
              "VAR _t = TOPN ( 1, FILTER ( VALUES ( 'FOM Category'[FOM Category] ), [GHP Findings YTD] > 0 ), [GHP Findings YTD], DESC )",
              "RETURN IF ( ISEMPTY ( _t ), \"None\", CONCATENATEX ( _t, 'FOM Category'[FOM Category] & \" (\" & FORMAT ( [GHP Findings YTD], \"#,0\" ) & \")\", \", \" ) )"
            ],
            "lineageTag": "3588ac8c-314f-46e1-8a89-22c17e9f2f38",
            "displayFolder": "3 Topsheet",
            "description": "GHP FOM category with the most, this FY to date"
          },
          {
            "name": "Top GHP Department YTD",
            "expression": [
              "VAR _t = TOPN ( 1, FILTER ( VALUES ( Department[Department] ), [GHP Findings YTD] > 0 ), [GHP Findings YTD], DESC )",
              "RETURN IF ( ISEMPTY ( _t ), \"None\", CONCATENATEX ( _t, Department[Department] & \" (\" & FORMAT ( [GHP Findings YTD], \"#,0\" ) & \")\", \", \" ) )"
            ],
            "lineageTag": "b99a0df1-6f13-460f-ad26-4dd0ac822c29",
            "displayFolder": "3 Topsheet",
            "description": "GHP department with the most, this FY to date"
          },
          {
            "name": "Top FOM Type YTD",
            "expression": [
              "VAR _t = TOPN ( 1, FILTER ( VALUES ( 'FOM Category'[FOM Category] ), [FOM Pieces YTD] > 0 ), [FOM Pieces YTD], DESC )",
              "RETURN IF ( ISEMPTY ( _t ), \"None\", CONCATENATEX ( _t, 'FOM Category'[FOM Category] & \" (\" & FORMAT ( [FOM Pieces YTD], \"#,0\" ) & \")\", \", \" ) )"
            ],
            "lineageTag": "8fa86eb4-565a-4e47-9fd3-7b3f19b64a6d",
            "displayFolder": "3 Topsheet",
            "description": "Line FOM type with the most, this FY to date"
          },
          {
            "name": "Top FOM Source YTD",
            "expression": [
              "VAR _t = TOPN ( 1, FILTER ( VALUES ( Department[Department] ), [FOM Pieces YTD] > 0 ), [FOM Pieces YTD], DESC )",
              "RETURN IF ( ISEMPTY ( _t ), \"None\", CONCATENATEX ( _t, Department[Department] & \" (\" & FORMAT ( [FOM Pieces YTD], \"#,0\" ) & \")\", \", \" ) )"
            ],
            "lineageTag": "e5ab9891-e5ab-42c9-8593-73e92538a368",
            "displayFolder": "3 Topsheet",
            "description": "Possible source department with the most, this FY to date"
          },
          {
            "name": "Top FOM Detection YTD",
            "expression": [
              "VAR _t = TOPN ( 1, FILTER ( VALUES ( LineFOM[Detection Group] ), [FOM Pieces YTD] > 0 ), [FOM Pieces YTD], DESC )",
              "RETURN IF ( ISEMPTY ( _t ), \"None\", CONCATENATEX ( _t, LineFOM[Detection Group] & \" (\" & FORMAT ( [FOM Pieces YTD], \"#,0\" ) & \")\", \", \" ) )"
            ],
            "lineageTag": "a5885502-059c-4699-9e4f-578eb971676e",
            "displayFolder": "3 Topsheet",
            "description": "Detection point with the most, this FY to date"
          },
          {
            "name": "GHP YTD Text",
            "expression": "FORMAT ( [GHP % Corrected YTD], \"0.0%\" ) & \" corrected · \" & [GHP Uncorrected YTD] & \" uncorrected\"",
            "lineageTag": "b7a36937-9f22-4523-b107-7b98b1f46d9d",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "GHP PM Text",
            "expression": "\"Last month (\" & FORMAT ( EDATE ( [Month Start], -1 ), \"mmm\" ) & \"): \" & [GHP Findings PM]",
            "lineageTag": "6e3d8daf-e03b-4631-bae7-94dc9331d3c9",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "GHP PW Text",
            "expression": "\"Last week: \" & [GHP Findings PW]",
            "lineageTag": "4203acd6-6144-4f67-8f6e-9d0906e0310e",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "FOM PM Text",
            "expression": "\"Last month (\" & FORMAT ( EDATE ( [Month Start], -1 ), \"mmm\" ) & \"): \" & [FOM Pieces PM]",
            "lineageTag": "2a888c9b-728d-4ab5-acea-d04bff1b5c03",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "FOM PW Text",
            "expression": "\"Last week: \" & [FOM Pieces PW]",
            "lineageTag": "82cff13b-ef02-410a-9811-b792cfbdcbbe",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "FOM YTD Text",
            "expression": "[FOM Incidents YTD] & \" incidents · \" & FORMAT ( [Running Line-Days YTD], \"#,0\" ) & \" running line-days\"",
            "lineageTag": "44514d3a-eb95-43b2-ba5a-430ac08aac4e",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "FOM Rate Text",
            "expression": "\"This month: \" & FORMAT ( [FOM per 100 Line-Days MTD], \"0.00\" )",
            "lineageTag": "a2e0e61a-4176-4e06-b756-25e074d1f0d4",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "Undated FOM Text",
            "expression": [
              "VAR _rows = CALCULATETABLE ( VALUES ( LineFOM[Excel Row] ), ISBLANK ( LineFOM[Date] ), LineFOM[FOM Count] > 0, REMOVEFILTERS ( 'Date' ) )",
              "VAR _n = CALCULATE ( SUM ( LineFOM[FOM Count] ), ISBLANK ( LineFOM[Date] ), REMOVEFILTERS ( 'Date' ) )",
              "RETURN",
              "    IF ( _n > 0, \"+\" & _n & \" piece(s) with no date – Excel row \" & CONCATENATEX ( _rows, LineFOM[Excel Row], \", \" ), [YTD Label] )"
            ],
            "lineageTag": "db6a2439-2216-4737-bbcc-6aec6656ea6e",
            "displayFolder": "3 Topsheet",
            "description": "FOM rows with no date cannot fall in a month or week: fix the date in Excel"
          },
          {
            "name": "FOM Color",
            "expression": "IF ( COALESCE ( [FOM Pieces], 0 ) > 0, \"#C62828\", \"#2E7D32\" )",
            "lineageTag": "4e75bff7-227b-43dd-bd75-f7198fe1e7b7",
            "displayFolder": "4 Colours",
            "description": "Red when any FOM piece (target 0)"
          },
          {
            "name": "FOM Color YTD",
