          },
          {
            "name": "GHP Corrected Color",
            "expression": "VAR _p = [GHP % Corrected] RETURN SWITCH ( TRUE (), ISBLANK ( _p ), \"#1B2A1E\", _p >= 1, \"#2E7D32\", _p >= 0.95, \"#F9A825\", \"#C62828\" )",
            "lineageTag": "66a1db91-3b59-4ef9-9ccf-451d35c70cf0",
            "displayFolder": "4 Colours",
            "description": "Green 100%, amber 95–99.9%, red below 95%"
          },
          {
            "name": "GHP Corrected Color YTD",
            "expression": "VAR _p = [GHP % Corrected YTD] RETURN SWITCH ( TRUE (), ISBLANK ( _p ), \"#1B2A1E\", _p >= 1, \"#2E7D32\", _p >= 0.95, \"#F9A825\", \"#C62828\" )",
            "lineageTag": "7defe738-6fa3-45d1-82c9-b25120ba2d44",
