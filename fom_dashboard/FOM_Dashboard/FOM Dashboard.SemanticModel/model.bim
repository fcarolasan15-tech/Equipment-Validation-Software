        ],
        "measures": [
          {
            "name": "GHP Findings",
            "expression": "COUNTROWS ( GHP )",
            "lineageTag": "6a94a1a8-897c-439b-b335-f60ed9b43bf1",
            "formatString": "#,0",
            "displayFolder": "1 Base",
            "description": "GHP inspection findings (rows in the Daily FOM Inspection log)"
          },
          {
            "name": "GHP Corrected",
            "expression": "CALCULATE ( [GHP Findings], GHP[Status] = \"Corrected\" )",
            "lineageTag": "d2258ffe-3f6c-4d3f-9ecb-6f66ed2439d3",
            "formatString": "#,0",
            "displayFolder": "1 Base"
          },
          {
            "name": "GHP Uncorrected",
            "expression": "CALCULATE ( [GHP Findings], GHP[Status] = \"Uncorrected\" )",
            "lineageTag": "c0bb4f91-771d-477b-884f-b05d986fb804",
            "formatString": "#,0",
            "displayFolder": "1 Base"
          },
          {
            "name": "GHP Not Stated",
            "expression": "CALCULATE ( [GHP Findings], GHP[Status] = \"Not stated\" )",
            "lineageTag": "27baa85b-c2e6-46e6-8e71-3e3d67acac11",
            "formatString": "#,0",
            "displayFolder": "1 Base",
            "description": "Status blank, or Minor / Critical typed in the Status column"
          },
          {
            "name": "GHP % Corrected",
            "expression": "DIVIDE ( [GHP Corrected], [GHP Corrected] + [GHP Uncorrected] )",
            "lineageTag": "9da52e55-cdb9-4301-9d8b-8998409ba80b",
            "formatString": "0.0%",
            "displayFolder": "1 Base",
            "description": "Corrected ÷ (Corrected + Uncorrected); findings with no status are left out"
          },
          {
            "name": "FOM Pieces",
            "expression": "VAR _n = SUM ( LineFOM[FOM Count] ) RETURN IF ( _n > 0, _n )",
            "lineageTag": "efb88db3-6f74-43aa-93ca-724ef401d030",
            "formatString": "#,0",
            "displayFolder": "1 Base",
            "description": "FOM pieces detected at the lines (sum of Count). Blank when none, so empty bars/rows disappear"
          },
          {
            "name": "FOM Incidents",
            "expression": "CALCULATE ( COUNTROWS ( LineFOM ), LineFOM[FOM Count] > 0 )",
            "lineageTag": "3483e7a0-c2b4-4858-8d1a-f8b7a9302b73",
            "formatString": "#,0",
            "displayFolder": "1 Base",
            "description": "Log rows with at least one FOM piece"
          },
          {
            "name": "Running Line-Days",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( LineFOM ),",
              "    LineFOM[Line Status] = \"Running\",",
              "    REMOVEFILTERS ( Department ),",
              "    REMOVEFILTERS ( 'FOM Category' )",
              ")"
            ],
            "lineageTag": "4fb99fad-8999-4150-955b-58f44d007b78",
            "formatString": "#,0",
            "displayFolder": "1 Base",
            "description": "Line-days with a Count of 0/1/2 (NR = not running is excluded). Ignores the department / category slicers"
          },
          {
            "name": "FOM per 100 Line-Days",
            "expression": "DIVIDE ( COALESCE ( [FOM Pieces], 0 ) * 100, [Running Line-Days] )",
            "lineageTag": "2720e24a-817e-4b85-912f-25f094aa02e1",
            "formatString": "0.00",
            "displayFolder": "1 Base",
            "description": "FOM pieces per 100 running line-days"
          },
          {
            "name": "GHP Findings (0)",
            "expression": "COALESCE ( [GHP Findings], 0 )",
            "lineageTag": "e1805b31-ed25-4371-90b0-9fcdd03f8f43",
            "formatString": "#,0",
            "displayFolder": "1 Base"
          },
          {
            "name": "GHP Uncorrected (0)",
            "expression": "COALESCE ( [GHP Uncorrected], 0 )",
            "lineageTag": "5947e69c-74e6-400d-b57e-771a1461c408",
            "formatString": "#,0",
            "displayFolder": "1 Base"
          },
          {
            "name": "FOM Pieces (0)",
            "expression": "COALESCE ( [FOM Pieces], 0 )",
            "lineageTag": "82c388fa-b02e-4674-9a0c-6e022dcd24bb",
            "formatString": "#,0",
            "displayFolder": "1 Base"
          },
          {
            "name": "FOM Incidents (0)",
            "expression": "COALESCE ( [FOM Incidents], 0 )",
            "lineageTag": "d2cee4d4-5131-456a-ba06-2e7ddcfa5226",
            "formatString": "#,0",
            "displayFolder": "1 Base"
          },
          {
            "name": "Report Date",
            "expression": [
              "MAX (",
              "    CALCULATE ( MAX ( GHP[Date] ), REMOVEFILTERS () ),",
              "    CALCULATE ( MAX ( LineFOM[Date] ), REMOVEFILTERS () )",
              ")"
            ],
            "lineageTag": "abddbc42-2899-4601-920d-737b4e95d02c",
            "formatString": "dd mmm yyyy",
            "displayFolder": "2 Dates & labels",
            "description": "Latest date in either file - the Topsheet tiles run to this date"
          },
          {
            "name": "FY Start",
            "expression": "VAR _d = [Report Date] RETURN DATE ( YEAR ( _d ) - IF ( MONTH ( _d ) < 5, 1, 0 ), 5, 1 )",
            "lineageTag": "9836317c-c037-4926-b391-56a61727fb83",
            "formatString": "dd mmm yyyy",
            "displayFolder": "2 Dates & labels",
            "description": "1 May of the fiscal year"
          },
          {
            "name": "Month Start",
            "expression": "VAR _d = [Report Date] RETURN DATE ( YEAR ( _d ), MONTH ( _d ), 1 )",
            "lineageTag": "d76c81d7-c050-4be6-8408-0f6eaad9e6bf",
            "formatString": "dd mmm yyyy",
            "displayFolder": "2 Dates & labels"
          },
          {
            "name": "Report Week Start",
            "expression": "VAR _d = [Report Date] RETURN _d - WEEKDAY ( _d, 2 ) + 1",
            "lineageTag": "70867670-9b5a-43b2-9eb3-518556505a6a",
            "formatString": "dd mmm yyyy",
            "displayFolder": "2 Dates & labels",
            "description": "Monday of the report week"
          },
          {
            "name": "Report Week Label",
            "expression": "LOOKUPVALUE ( 'Date'[Fiscal Week Label], 'Date'[Date], [Report Date] )",
            "lineageTag": "78ff1759-c75f-4870-acd5-373975a3cf17",
            "displayFolder": "2 Dates & labels"
          },
          {
            "name": "Header Subtitle",
            "expression": "\"Data through \" & FORMAT ( [Report Date], \"ddd d mmm yyyy\" ) & \" · \" & LOOKUPVALUE ( 'Date'[Fiscal Week], 'Date'[Date], [Report Date] )",
            "lineageTag": "34241680-31b4-4250-aefa-63f842767257",
            "displayFolder": "2 Dates & labels"
          },
          {
            "name": "YTD Label",
            "expression": "\"FY\" & RIGHT ( YEAR ( [FY Start] ) + 1, 2 ) & \" · \" & FORMAT ( [FY Start], \"d mmm\" ) & \" – \" & FORMAT ( [Report Date], \"d mmm yyyy\" )",
            "lineageTag": "9cf13f15-12fd-4885-8d93-756bc94074c9",
            "displayFolder": "2 Dates & labels"
          },
          {
            "name": "MTD Label",
            "expression": "FORMAT ( [Report Date], \"mmmm yyyy\" ) & \" · to \" & FORMAT ( [Report Date], \"d mmm\" )",
            "lineageTag": "9b8d231b-62bc-46d1-8c92-d3d335b9b3ff",
            "displayFolder": "2 Dates & labels"
          },
          {
            "name": "Selection Label",
            "expression": [
              "VAR _s = MIN ( 'Date'[Date] )",
              "VAR _e = MIN ( MAX ( 'Date'[Date] ), [Report Date] )",
              "RETURN \"Showing \" & FORMAT ( _s, \"d mmm\" ) & \" – \" & FORMAT ( _e, \"d mmm yyyy\" )"
            ],
            "lineageTag": "92d7b252-d5de-40d0-a99c-e3f920f2a298",
            "displayFolder": "2 Dates & labels",
            "description": "Dates the Monthly / Weekly tiles cover (all, or the clicked bar / slicer)"
          },
          {
            "name": "GHP Findings YTD",
            "expression": "COALESCE ( CALCULATE ( [GHP Findings], REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], [FY Start], [Report Date] ) ), 0 )",
            "lineageTag": "9e1f4175-02cd-44d5-9e79-67384e9c925d",
            "formatString": "#,0",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "FOM Pieces YTD",
            "expression": "COALESCE ( CALCULATE ( [FOM Pieces], REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], [FY Start], [Report Date] ) ), 0 )",
            "lineageTag": "a7610ed0-322b-4dce-b5b1-150ce0945f91",
            "formatString": "#,0",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "GHP Findings MTD",
            "expression": "COALESCE ( CALCULATE ( [GHP Findings], REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], [Month Start], [Report Date] ) ), 0 )",
            "lineageTag": "66a7e423-c489-4522-a39e-0dcc773b98fd",
            "formatString": "#,0",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "FOM Pieces MTD",
            "expression": "COALESCE ( CALCULATE ( [FOM Pieces], REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], [Month Start], [Report Date] ) ), 0 )",
            "lineageTag": "ae0a6219-85a7-40d5-b967-8c2213cf88c5",
            "formatString": "#,0",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "GHP Findings WTD",
            "expression": "COALESCE ( CALCULATE ( [GHP Findings], REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], [Report Week Start], [Report Date] ) ), 0 )",
            "lineageTag": "a08759cd-2fd2-41e4-b1f8-475a1ba79367",
            "formatString": "#,0",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "FOM Pieces WTD",
            "expression": "COALESCE ( CALCULATE ( [FOM Pieces], REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], [Report Week Start], [Report Date] ) ), 0 )",
            "lineageTag": "efca0b72-f103-47cc-a746-ef261bb094ed",
            "formatString": "#,0",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "GHP Findings PM",
            "expression": "COALESCE ( CALCULATE ( [GHP Findings], REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], EDATE ( [Month Start], -1 ), [Month Start] - 1 ) ), 0 )",
            "lineageTag": "89ceb208-353d-40d8-abd5-192968f30f36",
            "formatString": "#,0",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "FOM Pieces PM",
            "expression": "COALESCE ( CALCULATE ( [FOM Pieces], REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], EDATE ( [Month Start], -1 ), [Month Start] - 1 ) ), 0 )",
            "lineageTag": "0f856760-f182-4b0f-89e3-597de7553223",
            "formatString": "#,0",
            "displayFolder": "3 Topsheet"
          },
          {
            "name": "GHP Findings PW",
            "expression": "COALESCE ( CALCULATE ( [GHP Findings], REMOVEFILTERS ( 'Date' ), DATESBETWEEN ( 'Date'[Date], [Report Week Start] - 7, [Report Week Start] - 1 ) ), 0 )",
            "lineageTag": "7f47d7a5-3b16-4c75-bdd4-50e3cd3c5713",
            "formatString": "#,0",
            "displayFolder": "3 Topsheet"
          },
          {
